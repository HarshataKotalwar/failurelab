# Development defaults. Replace the password for any shared or non-local environment.
POSTGRES_DB=failurelab
POSTGRES_USER=failurelab
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

ORDER_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003

# Investigator defaults to the offline deterministic implementation.
INVESTIGATOR_PROVIDER=local
# Optional. Keep the real key in your ignored .env file or process environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_TO_LOCAL=true
